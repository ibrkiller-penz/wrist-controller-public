{
  "suite": "keymap",
  "description": "키맵 해석: (모드, 앱, OS, 동작) → 키 조합·표시 문자열·HID 수정자 바이트·사용 코드. 근거: docs/research/shortcuts.md 3장.",
  "cases": [
    {
      "mode": "present",
      "app": "powerpoint",
      "os": "win",
      "action": "next",
      "expect": {
        "chord": {
          "mods": [],
          "key": "RIGHT"
        },
        "label": "→",
        "modifier": "0x00",
        "usage": "0x4F"
      }
    },
    {
      "mode": "present",
      "app": "powerpoint",
      "os": "win",
      "action": "prev",
      "expect": {
        "chord": {
          "mods": [],
          "key": "LEFT"
        },
        "label": "←",
        "modifier": "0x00",
        "usage": "0x50"
      }
    },
    {
      "mode": "present",
      "app": "powerpoint",
      "os": "win",
      "action": "blackout",
      "expect": {
        "chord": {
          "mods": [],
          "key": "PERIOD"
        },
        "label": ".",
        "modifier": "0x00",
        "usage": "0x37"
      }
    },
    {
      "mode": "present",
      "app": "powerpoint",
      "os": "win",
      "action": "showStart",
      "expect": {
        "chord": {
          "mods": [],
          "key": "F5"
        },
        "label": "F5",
        "modifier": "0x00",
        "usage": "0x3E"
      }
    },
    {
      "mode": "present",
      "app": "powerpoint",
      "os": "mac",
      "action": "showStart",
      "expect": {
        "chord": {
          "mods": [
            "gui",
            "shift"
          ],
          "key": "ENTER"
        },
        "label": "Cmd+Shift+Return",
        "modifier": "0x0A",
        "usage": "0x28"
      }
    },
    {
      "mode": "present",
      "app": "powerpoint",
      "os": "win",
      "action": "showEnd",
      "expect": {
        "chord": {
          "mods": [],
