{
  "suite": "macro",
  "description": "매크로 단계 → HID 보고서 열(키보드 [수정자, 키] 누름 → [0,0] 뗌, 글자 사이 15ms, 소비자 키 → 0). 근거: docs/research/launcher.md 3장.",
  "cases": [
    {
      "id": "win-r-run",
      "desc": "Win+R → 300ms → \"ex\" → 50ms → Enter",
      "steps": [
        {
          "chord": {
            "mods": [
              "gui"
            ],
            "key": "R"
          }
        },
        {
          "wait": 300
        },
        {
          "text": "ex"
        },
        {
          "wait": 50
        },
        {
          "chord": {
            "mods": [],
            "key": "ENTER"
          }
        }
      ],
      "expect": {
        "reports": [
          {
            "r": "kbd",
            "mod": 8,
            "usage": 21
          },
          {
            "r": "kbd",
            "mod": 0,
            "usage": 0
          },
          {
            "r": "wait",
            "ms": 300
          },
          {
            "r": "kbd",
            "mod": 0,
            "usage": 8
          },
          {
            "r": "kbd",
            "mod": 0,
            "usage": 0
          },
          {
            "r": "wait",
            "ms": 15
          },
          {
            "r": "kbd",
            "mod": 0,
            "usage": 27
          },
          {
            "r": "kbd",
            "mod": 0,
            "usage": 0
          },
          {
            "r": "wait",
            "ms": 50
          },
          {
            "r": "kbd",
            "mod": 0,
            "usage": 40
          },
          {
            "r": "kbd",
            "mod": 0,
            "usage": 0
          }
        ],
        "label": "Win+R → ex → Enter"
      }
    },
