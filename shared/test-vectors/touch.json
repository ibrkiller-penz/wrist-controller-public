{
  "suite": "touch",
  "description": "터치 판정(TouchGesture) — 손 뗄 때 전송, 12px 탭 취소, 600ms 길게, 스와이프 80/60/1.5/800(쇼 중 140/50), 위에서 당기기 72/48/40/600. 기본: 발표 모드, PowerPoint, Windows, 연결됨.",
  "cases": [
    {
      "id": "send-on-release",
      "desc": "발표 오른쪽 누름: 누르는 순간에는 아무것도 보내지 않고, 뗄 때 다음(→) 1회",
      "init": {
        "mode": "present"
      },
      "steps": [
        {
          "at": 0,
          "touch": "down",
          "x": 350,
          "y": 260,
          "expect": {
            "inputs": [],
            "keys": []
          }
        },
        {
          "at": 50,
          "poll": true,
          "expect": {
            "inputs": [],
            "keys": []
          }
        },
        {
          "at": 120,
          "touch": "up",
          "x": 350,
          "y": 260,
          "expect": {
            "inputs": [
              {
                "t": "tap",
                "x": 350,
                "y": 260
              }
            ],
            "keys": [
              {
                "t": "key",
                "mods": [],
                "key": "RIGHT"
              }
            ]
          }
        }
      ]
    },
    {
