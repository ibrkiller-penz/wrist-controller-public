{
  "name": "wrist-controller-sim",
  "private": true,
  "version": "0.1.0",
  "description": "손목 컨트롤러 시뮬레이션 사이트 (Vite + TypeScript, 프레임워크 없음)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx firebase-tools deploy --only hosting:watchpeter",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
